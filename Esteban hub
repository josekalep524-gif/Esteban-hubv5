local WeaponNames = {
    "g3","c9","p226","glock","recortada","doble barril",
    "draco","skorpion","mp5","remington","m16","ak","rpg",
    "spooky rpg","anaconda","firework","rifle de casa",
    "m24","aug","awp","uzi","ballesta","m249",
    "cacerola","cuchillo pequeño","cuchillo de carnicero",
    "llave inglesa","bate de metal","bate normal","hacha",
    "machete","pala","martillo de batalla","hacha de combate",
    "bate con pinchos","cuchillo tac","pala tac","hacha tac",
    "energy shot","bolsa de sangre"
}

local WeaponLookup = {}

local function NormalizeWeaponName(name)
    return string.lower(tostring(name))
        :gsub("_"," ")
        :gsub("%-"," ")
        :gsub("%s+"," ")
        :match("^%s*(.-)%s*$")
end

for _,name in ipairs(WeaponNames) do
    WeaponLookup[NormalizeWeaponName(name)] = true
end

local function IsWeaponName(name)
    return WeaponLookup[NormalizeWeaponName(name)] == true
end

local function GetWeaponPart(object)
    if object:IsA("Tool") then
        local handle = object:FindFirstChild("Handle",true)
        if handle and handle:IsA("BasePart") then
            return handle
        end
    end

    if object:IsA("Model") then
        if object.PrimaryPart then
            return object.PrimaryPart
        end

        return object:FindFirstChildWhichIsA("BasePart",true)
    end

    return nil
end

local function RemoveWeaponESP(object)
    local data = WeaponESPObjects[object]
    if data then
        if data.Billboard then
            data.Billboard:Destroy()
        end
        WeaponESPObjects[object] = nil
    end
end

local function AddWeaponESP(object)
    if not object then return end
    if not (object:IsA("Model") or object:IsA("Tool")) then return end
    if WeaponESPObjects[object] then return end
    if not IsWeaponName(object.Name) then return end

    local part = GetWeaponPart(object)
    if not part then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EstebanWeaponESP"
    billboard.Size = UDim2.fromOffset(140,20)
    billboard.StudsOffset = Vector3.new(0,2,0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = part
    billboard.Enabled = false
    billboard.Parent = GUI

    local label = Instance.new("TextLabel")
    label.Name = "WeaponName"
    label.Size = UDim2.fromScale(1,1)
    label.BackgroundTransparency = 1
    label.Text = object.Name
    label.TextColor3 = Color3.fromRGB(255,100,100)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0,0,0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = Config.WeaponTextSize
    label.Parent = billboard

    WeaponESPObjects[object] = {
        Billboard = billboard,
        Label = label,
        Part = part
    }
end

local function ScanWeaponESP()
    for _,object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Model") or object:IsA("Tool") then
            AddWeaponESP(object)
        end
    end
end

