local function MobileButton(text,position,callback,canMove)
    local B = Instance.new("TextButton")
    B.Size = UDim2.fromOffset(90,38)
    B.Position = position
    B.BackgroundColor3 = Red
    B.Text = text
    B.TextColor3 = White
    B.TextSize = 11
    B.Font = Enum.Font.GothamBold
    B.Active = true
    B.Parent = GUI

    Instance.new("UICorner",B)

    local tracking = false
    local moved = false
    local startPosition
    local startInputPosition
    local activeInputType

    B.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            tracking = true
            moved = false
            activeInputType = "Touch"
            startInputPosition = input.Position
            startPosition = B.Position
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            tracking = true
            moved = false
            activeInputType = "Mouse"
            startInputPosition = input.Position
            startPosition = B.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not tracking then return end

        local validMove =
            (activeInputType == "Touch" and input.UserInputType == Enum.UserInputType.Touch)
            or (activeInputType == "Mouse" and input.UserInputType == Enum.UserInputType.MouseMovement)

        if not validMove then return end

        local delta = input.Position-startInputPosition

        if delta.Magnitude > 7 then
            moved = true
        end

        if canMove and not ButtonsLocked and moved then
            B.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset+delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset+delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if not tracking then return end

        local ended =
            (activeInputType == "Touch" and input.UserInputType == Enum.UserInputType.Touch)
            or (activeInputType == "Mouse" and input.UserInputType == Enum.UserInputType.MouseButton1)

        if not ended then return end

        tracking = false

        if not moved then
            callback()
        end

        activeInputType = nil
    end)

    return B
end

