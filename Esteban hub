local function Slider(name,minValue,maxValue,defaultValue,callback,integer)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1,-5,0,62)
    Container.BackgroundColor3 = Panel
    Container.ZIndex = 3
    Container.Parent = CurrentPage

    Instance.new("UICorner",Container)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1,-15,0,23)
    Label.Position = UDim2.fromOffset(8,2)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = White
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 11
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 4
    Label.Parent = Container

    local Bar = Instance.new("Frame")
    Bar.Size = UDim2.new(1,-20,0,8)
    Bar.Position = UDim2.fromOffset(10,38)
    Bar.BackgroundColor3 = Color3.fromRGB(75,45,50)
    Bar.BorderSizePixel = 0
    Bar.ZIndex = 4
    Bar.Parent = Container

    Instance.new("UICorner",Bar)

    local Fill = Instance.new("Frame")
    Fill.BackgroundColor3 = Red
    Fill.Size = UDim2.new(0,0,1,0)
    Fill.BorderSizePixel = 0
    Fill.ZIndex = 5
    Fill.Parent = Bar

    Instance.new("UICorner",Fill)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.fromOffset(15,15)
    Knob.AnchorPoint = Vector2.new(0.5,0.5)
    Knob.Position = UDim2.new(0,0,0.5,0)
    Knob.BackgroundColor3 = White
    Knob.ZIndex = 6
    Knob.Parent = Bar

    Instance.new("UICorner",Knob).CornerRadius = UDim.new(1,0)

    local function SetValue(v)
        if integer then
            v = math.floor(v+0.5)
        end

        local percent = math.clamp(
            (v-minValue)/(maxValue-minValue),
            0,1
        )

        Fill.Size = UDim2.new(percent,0,1,0)
        Knob.Position = UDim2.new(percent,0,0.5,0)
        Label.Text = name..": "..v
        callback(v)
    end

    local function Update(x)
        local width = Bar.AbsoluteSize.X
        if width <= 0 then return end

        local percent = math.clamp(
            (x-Bar.AbsolutePosition.X)/width,
            0,1
        )

        SetValue(minValue+(maxValue-minValue)*percent)
    end

    local active = false

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            Update(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if active and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            Update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = false
        end
    end)

    SetValue(defaultValue)
end

