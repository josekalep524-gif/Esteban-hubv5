local frames = 0
local last = os.clock()
local shakeTime = 0

RunService.RenderStepped:Connect(function(dt)
    Camera = workspace.CurrentCamera or Camera

    Hue = (Hue+dt*Config.RGBSpeed)%1
    local RGBColor = Color3.fromHSV(Hue,1,1)

    if Config.RGB then
        Border.Color = RGBColor
        Title.TextColor3 = RGBColor
        Subtitle.TextColor3 = RGBColor
    else
        Border.Color = Red
        Title.TextColor3 = Red
        Subtitle.TextColor3 = Color3.fromRGB(255,100,110)
    end

    if SmokeEmitter and SmokeEmitter.Parent then
        SmokeEmitter.Color = ColorSequence.new(RGBColor)
    end

    -- AIM ASSIST
    if Config.AimAssist then
        local target = GetTarget()

        if target and target.Parent then
            local position = target.Position

            if Config.AimPrediction then
                position += target.AssemblyLinearVelocity*0.12
            end

            local strengths = {
                Suave = 0.04,
                Medio = 0.10,
                Fuerte = 0.25,
                Extremo = 1
            }

            local amount = strengths[Config.AimStrength] or 0.10

            if Config.AimStrength ~= "Extremo" then
                amount = math.clamp(
                    amount*(Config.AimSmoothness/0.10),
                    0.01,
                    0.85
                )
            end

            local desired = CFrame.lookAt(
                Camera.CFrame.Position,
                position
            )

            Camera.CFrame = Camera.CFrame:Lerp(desired,amount)
        end
    end

    -- PLAYER ESP + TRACERS
    for plr,data in pairs(ESPObjects) do
        local character = plr.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if root and humanoid and humanoid.Health > 0 then
            local distance = math.huge

            local myCharacter = Player.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

            if myRoot then
                distance = (myRoot.Position-root.Position).Magnitude
            end

            local inRange = distance <= Config.ESPDistance
            local color = Config.RGB and RGBColor or Red

            data.Highlight.Enabled = Config.Chams and inRange
            data.Highlight.FillColor = color
            data.Highlight.OutlineColor = color

            data.Name.Visible = Config.ESPName
            data.Name.Text = plr.DisplayName
            data.Name.TextColor3 = color

            data.Health.Visible = Config.ESPHealth
            data.Health.Text =
                "HP: "..math.floor(humanoid.Health)
                .."/"..math.floor(humanoid.MaxHealth)

            data.Weapon.Visible = Config.ESPWeapons
            data.Weapon.TextSize = Config.WeaponTextSize

            local equippedTool = character:FindFirstChildOfClass("Tool")
            data.Weapon.Text = equippedTool and equippedTool.Name or "Sin arma"

            local _,visible = Camera:WorldToViewportPoint(root.Position)

            data.Billboard.Enabled =
                visible and inRange and (
                    Config.ESPName
                    or Config.ESPHealth
                    or Config.ESPWeapons
                )

            data.TracerPart.CFrame = CFrame.new(Camera.CFrame.Position)

            if data.EndAttachment.Parent ~= root then
                data.EndAttachment.Parent = root
            end

            data.Tracer.Enabled = Config.Tracers and inRange
            data.Tracer.Color = ColorSequence.new(color)
        else
            data.Billboard.Enabled = false
            data.Highlight.Enabled = false
            data.Tracer.Enabled = false
        end
    end

    -- WORLD WEAPON ESP
    local myCharacter = Player.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    for object,data in pairs(WeaponESPObjects) do
        if not object.Parent then
            RemoveWeaponESP(object)
        else
            local part = GetWeaponPart(object)

            if not part then
                data.Billboard.Enabled = false
            else
                data.Part = part
                data.Billboard.Adornee = part

                local distance = math.huge

                if myRoot then
                    distance = (myRoot.Position-part.Position).Magnitude
                end

                local inRange = distance <= Config.WeaponESPDistance

                data.Billboard.Enabled = Config.ESPWeapons and inRange
                data.Label.Text = object.Name
                data.Label.TextSize = Config.WeaponTextSize
            end
        end
    end

    -- CAMERA SHAKE
    if Config.CameraShake then
        shakeTime += dt*15
        local amount = Config.ShakeIntensity*0.002

        local offset = Vector3.new(
            math.sin(shakeTime)*amount,
            math.cos(shakeTime*1.3)*amount,
            0
        )

        Camera.CFrame = Camera.CFrame*CFrame.new(offset)
    end

    -- FPS / PING
    frames += 1

    if os.clock()-last >= 1 then
        local fps = frames
        frames = 0
        last = os.clock()

        local ping = 0

        pcall(function()
            ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)

        StatsLabel.Text =
            "FPS: "..fps..
            "\nPING: "..math.floor(ping).." ms"
    end
end)

